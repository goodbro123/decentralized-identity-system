<view class="page">

  <!-- 顶部说明 -->
  <view class="header-card">
    <view class="header-top">
      <view>
        <view class="badge">DID VERIFY</view>
        <view class="title">身份认证</view>
      </view>

      <view class="status-pill {{backendOk ? 'online' : 'offline'}}">
        {{backendOk ? '后端在线' : '后端离线'}}
      </view>
    </view>

    <view class="subtitle">
      对 DID 的链上状态、链下文档、文档哈希、默克尔根、版本哈希链和交易状态进行完整性认证。
    </view>
  </view>

  <!-- 认证输入 -->
  <view class="section-card">
    <view class="section-title">发起认证</view>
    <view class="section-desc">默认验证当前绑定 DID 的最新版本，也可以指定历史版本号。</view>

    <view class="field">
      <view class="label">DID 标识</view>
      <input
        class="input"
        placeholder="例如：did:ethr:alice"
        placeholder-class="placeholder"
        value="{{did}}"
        data-field="did"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">版本号，可选</view>
      <input
        class="input"
        type="number"
        placeholder="不填写则验证当前版本"
        placeholder-class="placeholder"
        value="{{version}}"
        data-field="version"
        bindinput="onInput"
      />
    </view>

    <view class="button-row">
      <button class="secondary-btn" bindtap="useCurrentDid">
        当前 DID
      </button>

      <button class="primary-btn" loading="{{verifying}}" bindtap="startVerify">
        {{verifying ? '认证中' : '发起认证'}}
      </button>
    </view>
  </view>

  <!-- 等待认证 -->
  <view class="empty-card" wx:if="{{!verified && !loading}}">
    <t-icon name="secured" size="48rpx" color="#8E98A8" />
    <view class="empty-title">等待认证</view>
    <view class="empty-desc">
      点击“发起认证”后，系统将调用 /api/did/verify 检查 DID 文档是否可信。
    </view>
  </view>

  <!-- 整体认证结果 -->
  <view class="result-card {{summaryClass}}" wx:if="{{verified}}">
    <view class="result-icon {{summaryClass}}">
      <t-icon
        name="{{isValid ? 'check-circle' : 'close-circle'}}"
        size="52rpx"
        color="currentColor"
      />
    </view>

    <view class="result-main">
      <view class="result-title">{{summaryText}}</view>
      <view class="result-desc">{{summaryDesc}}</view>
      <view class="result-time">认证时间：{{verifyTimeText}}</view>
    </view>
  </view>

  <!-- 分项校验结果 -->
  <view class="section-card" wx:if="{{verified}}">
    <view class="section-title">分项校验结果</view>
    <view class="section-desc">根据后端 verify_did_service 返回结果逐项展示。</view>

    <view class="check-list">
      <view
        wx:for="{{checkItems}}"
        wx:key="key"
        class="check-item"
      >
        <view class="check-icon {{item.statusClass}}">
          <t-icon
            name="{{item.status === true ? 'check' : item.status === false ? 'close' : 'minus'}}"
            size="30rpx"
            color="currentColor"
          />
        </view>

        <view class="check-main">
          <view class="check-title">{{item.title}}</view>
          <view class="check-desc">{{item.desc}}</view>
        </view>

        <view class="check-status {{item.statusClass}}">
          {{item.statusText}}
        </view>
      </view>
    </view>
  </view>

  <!-- 链上状态 -->
  <view class="section-card" wx:if="{{verified && chainState}}">
    <view class="section-title">链上状态</view>
    <view class="section-desc">智能合约中记录的 DID 最新状态。</view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">version</view>
        <view class="hash-value">{{chainState.version || '-'}}</view>
      </view>
    </view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">document_hash</view>
        <view class="hash-value">
          {{chainState.document_hash || chainState.doc_hash || '-'}}
        </view>
      </view>
    </view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">merkle_root</view>
        <view class="hash-value">
          {{chainState.merkle_root || chainState.status_root || '-'}}
        </view>
      </view>
    </view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">version_hash</view>
        <view class="hash-value">
          {{chainState.version_hash || chainState.vh_latest || '-'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 重计算结果 -->
  <view class="section-card" wx:if="{{verified && recomputedTarget}}">
    <view class="section-title">重计算目标摘要</view>
    <view class="section-desc">后端基于目标 DID 文档重新计算得到的摘要字段。</view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">document_hash</view>
        <view class="hash-value">
          {{recomputedTarget.document_hash || recomputedTarget.doc_hash || '-'}}
        </view>
      </view>
    </view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">merkle_root</view>
        <view class="hash-value">
          {{recomputedTarget.merkle_root || recomputedTarget.status_root || '-'}}
        </view>
      </view>
    </view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">version_hash</view>
        <view class="hash-value">
          {{recomputedTarget.version_hash || recomputedTarget.vh_latest || '-'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 交易状态 -->
  <view class="section-card" wx:if="{{verified && transactionStatus}}">
    <view class="section-title">交易状态</view>
    <view class="section-desc">链上写入交易的验证结果。</view>

    <view class="status-grid">
      <view class="status-item">
        <view class="status-label">交易状态</view>
        <view class="status-value {{transactionStatus.status == 1 ? 'success' : transactionStatus.status == 0 ? 'danger' : 'warning'}}">
          {{transactionStatus.status == 1 ? '成功' : transactionStatus.status == 0 ? '失败' : '未检测'}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">Gas Used</view>
        <view class="status-value small">
          {{transactionStatus.gas_used || transactionStatus.gasUsed || '-'}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">区块高度</view>
        <view class="status-value small">
          {{transactionStatus.block_number || transactionStatus.blockNumber || '-'}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">Receipt Status</view>
        <view class="status-value small">
          {{transactionStatus.status === undefined ? '-' : transactionStatus.status}}
        </view>
      </view>
    </view>

    <view class="hash-row">
      <view class="hash-main">
        <view class="hash-label">tx_hash</view>
        <view class="hash-value">
          {{transactionStatus.tx_hash || transactionStatus.transaction_hash || transactionStatus.transactionHash || '-'}}
        </view>
      </view>
    </view>
  </view>



  <!-- 错误详情 -->
  <view class="section-card" wx:if="{{verified && errorList.length > 0}}">
    <view class="section-title">错误详情</view>
    <view class="section-desc">主要来自后端 history_errors 或异常信息。</view>

    <view class="error-list">
      <view
        wx:for="{{errorList}}"
        wx:key="*this"
        class="error-item"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 原始结果 JSON -->
  <view class="section-card" wx:if="{{verified}}">
    <view class="section-head">
      <view>
        <view class="section-title">认证结果 JSON</view>
        <view class="section-desc">后端返回的完整认证结果</view>
      </view>

      <view class="copy-btn" bindtap="copyResultJson">
        复制
      </view>
    </view>

    <view class="json-box">
      <text>{{resultJson || '暂无认证结果'}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-card">
    <view class="bottom-text">
      <view class="bottom-title">认证说明</view>
      <view class="bottom-desc">
        身份认证不会修改 DID 数据，只检查链上状态、链下文档和历史版本是否可信。
      </view>
    </view>

  </view>

</view>