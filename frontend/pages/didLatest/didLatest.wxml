<view class="page">

  <!-- 顶部说明 -->
  <view class="header-card">
    <view class="header-top">
      <view>
        <view class="badge">DID LATEST</view>
        <view class="title">状态查询</view>
      </view>

      <view class="status-pill {{backendOk ? 'online' : 'offline'}}">
        {{backendOk ? '后端在线' : '后端离线'}}
      </view>
    </view>

    <view class="subtitle">
      查询指定 DID 的链上可信状态与链下当前文档，用于判断身份文档是否可追溯、可校验。
    </view>
  </view>

  <!-- 查询表单 -->
  <view class="section-card">
    <view class="section-title">查询 DID</view>
    <view class="section-desc">默认使用当前绑定 DID，也可以手动输入其他 DID。</view>

    <view class="field">
      <view class="label">DID 标识</view>
      <input
        class="input"
        placeholder="例如：did:ethr:alice"
        placeholder-class="placeholder"
        value="{{did}}"
        bindinput="onDidInput"
      />
    </view>

    <view class="button-row">
      <button class="secondary-btn" bindtap="useCurrentDid">
        当前 DID
      </button>

      <button class="primary-btn" loading="{{loading}}" bindtap="queryLatest">
        {{loading ? '查询中' : '查询状态'}}
      </button>
    </view>
  </view>

  <!-- 查询结果为空 -->
  <view class="empty-card" wx:if="{{queried && !result && !loading}}">
    <t-icon name="info-circle" size="46rpx" color="#8E98A8" />
    <view class="empty-title">暂无查询结果</view>
    <view class="empty-desc">请确认 DID 是否存在，或检查后端服务与链上合约状态。</view>
  </view>

  <!-- 链上状态 -->
  <view class="section-card" wx:if="{{result}}">
    <view class="section-head">
      <view>
        <view class="section-title">链上状态</view>
        <view class="section-desc">来自智能合约的最新 DID 状态锚点</view>
      </view>

      <view class="chain-badge">
        On-chain
      </view>
    </view>

    <view class="status-grid">
      <view class="status-item">
        <view class="status-label">版本号</view>
        <view class="status-value">
          {{chainState.version || '-'}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">更新时间</view>
        <view class="status-value small">
          {{chainUpdatedAtText}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">链上状态</view>
        <view class="status-value success">
          {{chainState.exists === false ? '不存在' : '存在'}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">当前 DID</view>
        <view class="status-value small">
          {{did}}
        </view>
      </view>
    </view>
  </view>

  <!-- 链下文档 -->
  <view class="section-card" wx:if="{{result}}">
    <view class="section-head">
      <view>
        <view class="section-title">链下当前文档</view>
        <view class="section-desc">来自 MongoDB 的 DID 当前有效文档</view>
      </view>

      <view class="chain-badge storage">
        Off-chain
      </view>
    </view>

    <view class="status-grid">
      <view class="status-item">
        <view class="status-label">文档版本</view>
        <view class="status-value">
          {{currentDocument.version || '-'}}
        </view>
      </view>

      <view class="status-item"> 
        <view class="status-label">文档状态</view>
        <view class="status-value {{documentMissing ? 'danger' : 'success'}}">
          {{documentMissing ? 'missing' : (currentDocument.status || 'active')}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">创建时间</view>
        <view class="status-value small">
          {{documentCreatedAtText}}
        </view>
      </view>

      <view class="status-item">
        <view class="status-label">更新时间</view>
        <view class="status-value small">
          {{documentUpdatedAtText}}
        </view>
      </view>
    </view>
  </view>

  <!-- 摘要字段 -->
  <view class="section-card" wx:if="{{result}}">
    <view class="section-title">可信摘要字段</view>
    <view class="section-desc">这些字段用于链上链下一致性校验，可点击复制。</view>

    <view class="hash-row" bindtap="copyDocumentHash">
      <view class="hash-main">
        <view class="hash-label">document_hash</view>
        <view class="hash-value">
          {{chainState.document_hash || chainState.doc_hash || currentDocument.document_hash || currentDocument.doc_hash || '-'}}
        </view>
      </view>
      <t-icon name="copy" size="32rpx" color="#5F6775" />
    </view>

    <view class="hash-row" bindtap="copyMerkleRoot">
      <view class="hash-main">
        <view class="hash-label">merkle_root / status_root</view>
        <view class="hash-value">
          {{chainState.merkle_root || chainState.status_root || currentDocument.merkle_root || currentDocument.status_root || '-'}}
        </view>
      </view>
      <t-icon name="copy" size="32rpx" color="#5F6775" />
    </view>

    <view class="hash-row" bindtap="copyVersionHash">
      <view class="hash-main">
        <view class="hash-label">version_hash / vh_latest</view>
        <view class="hash-value">
          {{chainState.version_hash || chainState.vh_latest || currentDocument.version_hash || currentDocument.vh_latest || '-'}}
        </view>
      </view>
      <t-icon name="copy" size="32rpx" color="#5F6775" />
    </view>
  </view>

  <!-- DID 文档 JSON -->
  <view class="section-card" wx:if="{{result}}">
    <view class="section-head">
      <view>
        <view class="section-title">DID 文档内容</view>
        <view class="section-desc">当前链下保存的 DID Document</view>
      </view>

      <view class="copy-btn" bindtap="copyDocumentJson">
        复制
      </view>
    </view>

    <view class="json-box">
      <text>{{documentJson || '暂无文档内容'}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-card">
    <view class="bottom-text">
      <view class="bottom-title">状态查询说明</view>
      <view class="bottom-desc">
        本页只负责查询 DID 的当前状态。若要修改文档、发起认证或恢复数据，请返回操作中心。
      </view>
    </view>
  </view>

</view>